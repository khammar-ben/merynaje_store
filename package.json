{
  "name": "merynaje_store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/image-variants.mjs && node scripts/icons.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/image-variants.mjs && node scripts/icons.mjs && node --experimental-strip-types --no-warnings scripts/og-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-windows-export.mjs",
    "preview": "npx serve@14 out",
    "assets": "node scripts/copy-assets.mjs && node scripts/image-variants.mjs",
    "lint": "eslint",
    "og": "node --experimental-strip-types --no-warnings scripts/og-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
